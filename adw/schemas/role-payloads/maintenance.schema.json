{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smith:adw:role:maintenance:v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "reason"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "noop"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "summary",
        "actions"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "action"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "actions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "verdict",
              "entityId",
              "reason"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "retry",
                  "hold",
                  "report"
                ]
              },
              "entityId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          }
        }
      }
    }
  ]
}
