{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smith:adw:role:pioneer:v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "reason"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "noop"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "summary",
        "claim",
        "patch"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "proved"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "patch": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "baseSha",
                "digest",
                "size",
                "files"
              ],
              "properties": {
                "baseSha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                },
                "files": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "kind",
                      "oldMode",
                      "newMode"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "kind": {
                        "const": "regular"
                      },
                      "oldMode": {
                        "enum": [
                          "absent",
                          "100644",
                          "100755"
                        ]
                      },
                      "newMode": {
                        "enum": [
                          "absent",
                          "100644",
                          "100755"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "summary",
        "claim",
        "patch"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "disproved"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "patch": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "summary",
        "claim",
        "patch"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "inconclusive"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "patch": {
          "type": "null"
        }
      }
    }
  ]
}
