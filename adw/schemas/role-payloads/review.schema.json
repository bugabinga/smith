{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smith:adw:role:review:v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "reason"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "noop"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "risk",
        "findings"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "risk": {
          "enum": [
            "none",
            "high"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "severity",
              "path",
              "line",
              "message"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          }
        }
      }
    }
  ]
}
