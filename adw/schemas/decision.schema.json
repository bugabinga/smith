{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smith:adw:decision:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "controlSha", "snapshotDigest", "assessmentDigests", "kind", "operations", "patch"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "controlSha": { "$ref": "#/$defs/sha" },
    "snapshotDigest": { "$ref": "#/$defs/digest" },
    "assessmentDigests": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
    "kind": { "enum": ["state", "patch", "terminal"] },
    "operations": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
    "patch": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/patch" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "patch" } }, "required": ["kind"] },
      "then": { "properties": { "patch": { "$ref": "#/$defs/patch" } } },
      "else": { "properties": { "patch": { "type": "null" } } }
    }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSha", "digest", "size", "files"],
      "properties": {
        "baseSha": { "$ref": "#/$defs/sha" },
        "digest": { "$ref": "#/$defs/digest" },
        "size": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "files": { "type": "array", "maxItems": 100, "items": { "type": "object" } }
      }
    }
  }
}
